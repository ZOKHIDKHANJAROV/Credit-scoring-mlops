# Bind published Docker ports to localhost by default.
# Change to 0.0.0.0 only if you intentionally want LAN/external access.
HOST_BIND_ADDRESS=127.0.0.1

# Host ports. Change these if another local project already uses the defaults.
POSTGRES_HOST_PORT=55432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MLFLOW_HOST_PORT=5000
API_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
AIRFLOW_HOST_PORT=8080
REDPANDA_HOST_PORT=19092
REDPANDA_ADMIN_HOST_PORT=9644
KAFKA_UI_HOST_PORT=8081
KAFKA_CONSUMER_METRICS_HOST_PORT=8001

MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
DATABASE_URL=postgresql+psycopg2://mlflow:mlflow@127.0.0.1:55432/mlflow
